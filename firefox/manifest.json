{
  "manifest_version": 3,
  "name": "KZT to RUB Converter",
  "version": "1.0.0",
  "description": "Конвертер валют KZT в RUB",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.cbr-xml-daily.ru/*"
  ],

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "kzt-to-rub-converter@example.com",
      "strict_min_version": "109.0"
    }
  }
}